{
  "name": "@richardmcquiston01/ai-tools",
  "version": "0.1.1",
  "description": "In-browser AI image tools (background removal, upscaling, auto-crop) for laser/CNC/maker workflows",
  "keywords": [
    "background-removal",
    "upscaling",
    "auto-crop",
    "onnx",
    "image-processing",
    "laser",
    "cnc",
    "engraving",
    "maker",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://github.com/RichardMcQuiston01/maker-image-tools#readme",
  "bugs": {
    "url": "https://github.com/RichardMcQuiston01/maker-image-tools/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardMcQuiston01/maker-image-tools.git",
    "directory": "packages/ai-tools"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "models",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@richardmcquiston01/core-image": "workspace:*",
    "@tensorflow/tfjs": "4.11.0",
    "@upscalerjs/esrgan-slim": "1.0.0",
    "onnxruntime-web": "1.27.0",
    "upscaler": "1.0.0"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
