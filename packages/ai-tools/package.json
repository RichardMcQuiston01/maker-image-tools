{
  "name": "@richardmcquiston01/ai-tools",
  "version": "0.5.1",
  "description": "In-browser AI image tools (background removal, upscaling, auto-crop, depth estimation) for laser/CNC/maker workflows",
  "keywords": [
    "background-removal",
    "upscaling",
    "auto-crop",
    "depth-estimation",
    "onnx",
    "image-processing",
    "laser",
    "cnc",
    "engraving",
    "maker",
    "typescript",
    "image-generator"
  ],
  "license": "MIT",
  "funding": {
    "type": "individual",
    "url": "https://donate.stripe.com/00w5kD3Gj1Xo9v7gVOcs800"
  },
  "homepage": "https://github.com/RichardMcQuiston01/maker-image-tools#readme",
  "bugs": {
    "url": "https://github.com/RichardMcQuiston01/maker-image-tools/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardMcQuiston01/maker-image-tools.git",
    "directory": "packages/ai-tools"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./background-removal": "./src/background-removal.ts",
    "./upscale": "./src/upscale.ts",
    "./auto-crop": "./src/auto-crop.ts",
    "./depth": "./src/depth.ts",
    "./provider": "./src/provider.ts",
    "./models/*": "./models/*"
  },
  "files": [
    "dist",
    "models",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@richardmcquiston01/core-image": "workspace:*",
    "@tensorflow/tfjs": "4.11.0",
    "@upscalerjs/esrgan-slim": "1.0.0",
    "onnxruntime-web": "1.27.0",
    "upscaler": "1.0.0"
  },
  "devDependencies": {
    "@richardmcquiston01/ai-providers": "^0.1.0",
    "esbuild": "^0.25.12",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "peerDependencies": {
    "@richardmcquiston01/ai-providers": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@richardmcquiston01/ai-providers": {
      "optional": true
    }
  },
  "sideEffects": false
}
